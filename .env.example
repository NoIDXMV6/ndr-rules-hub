# ── NDR Rules Hub — переменные окружения ─────────────────────────────────────
# Скопируйте в .env и заполните:  cp .env.example .env

# Oinkcode из профиля snort.org (для автоматической загрузки registered rules).
# Достаточно oinkcode — логин/пароль не нужны. Можно также задать через UI → Настройки.
OINKCODE=

# Строка подключения Prisma к БД SQLite (в контейнере — /app/data/hub.db).
DATABASE_URL=file:/app/data/hub.db

# Каталог данных сервиса (кэш архивов, экспорт, WireGuard-конфиги)
RULES_DATA_DIR=/app/data
WG_CONFIG_DIR=/app/data/wireguard

# Необязательно: каталог локальных архивов правил для первичного наполнения
# (по умолчанию data/archives). Раскомментируйте при необходимости.
#RULES_LOCAL_ARCHIVES_DIR=data/archives

# Часовой пояс планировщика
TZ=Europe/Moscow
