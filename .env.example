# ── NDR Rules Hub — переменные окружения ─────────────────────────────────────
# Скопируйте в .env и заполните:  cp .env.example .env

# Oinkcode из профиля snort.org (для автоматической загрузки registered rules).
# Достаточно oinkcode — логин/пароль не нужны. Можно также задать через UI → Настройки.
OINKCODE=

# Строка подключения Prisma к БД SQLite (в контейнере — /app/data/hub.db).
DATABASE_URL=file:/app/data/hub.db

# Каталог данных сервиса (кэш архивов, экспорт, WireGuard-конфиги)
RULES_DATA_DIR=/app/data
WG_CONFIG_DIR=/app/data/wireguard

# Необязательно: каталог локальных архивов правил для первичного наполнения
# (по умолчанию data/archives). Раскомментируйте при необходимости.
#RULES_LOCAL_ARCHIVES_DIR=data/archives

# Глобальный таймаут проверки/докатки схемы БД при старте контейнера
# (db-heal, секунды). На огромной БД / медленном диске увеличьте; при
# превышении БД НЕ стирается — сервер стартует с существующей БД.
DB_HEAL_TIMEOUT=300

# Порог размера БД (MB), выше которого скан целостности ПРОПУСКАЕТСЯ при
# старте (v1.36.2): на большой БД скан идёт минутами и раньше обрывал докатку
# схемы. Докатка схемы выполняется всегда. 0 — всегда сканировать; полный
# скан вручную: NDR_DB_FULL_CHECK=1 (+ увеличьте DB_HEAL_TIMEOUT_MS).
#DB_HEAL_CHECK_SKIP_MB=400

# Часовой пояс планировщика
TZ=Europe/Moscow

# Редакция системы:
#   community  (по умолчанию) — однопользовательский режим, без аутентификации
#   enterprise — многопользовательский режим: регистрация, верификация
#                администратором, личный кабинет, персональные токены скачивания
NDR_EDITION=community

# ── Сборка образа (этап deps) ────────────────────────────────────────────────
# Начиная с v1.36.1 зеркала выбираются АВТОМАТИЧЕСКИ (scripts/bun-install.sh):
# перед установкой каждое зеркало предпроверяется лёгким GET /ms (таймаут 15с),
# порядок попыток — по возрастанию времени ответа, деградировавшие (>3000мс на
# запрос) — в конец очереди, не ответившие исключаются; на каждую попытку bun
# install действует свой предохранитель. Кандидаты по умолчанию:
# registry.npmjs.org → registry.npmmirror.com → npm-mirror.gitverse.ru.
# NPM_REGISTRY — основное зеркало (проверяется ПЕРВЫМ, но в очередь встаёт по
# фактической скорости; пусто = чистый авто-выбор):
# NPM_REGISTRY=https://npm-mirror.gitverse.ru
# NPM_REGISTRY=https://registry.npmmirror.com
# Свой полный список зеркал (заменяет дефолтных кандидатов целиком):
# BUN_REGISTRIES=https://registry.npmjs.org https://registry.npmmirror.com
# Предохранитель bun install — секунды НА ПОПЫТКУ (дефолт 900; до v1.36.1 был
# общий на шаг — 2700).
# BUN_INSTALL_TIMEOUT=900
