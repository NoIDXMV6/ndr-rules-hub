generator client {
  provider = "prisma-client-js"
  // debian-openssl-3.0.x — runtime-образ node:22-bookworm-slim;
  // builder (oven/bun:1.2, bullseye/openssl-1.1) покрыт "native".
  // Без явного таргета клиент генерировался только под builder и падал
  // в контейнере: "Prisma Client could not locate the Query Engine
  // for runtime debian-openssl-3.0.x".
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Источник правил: ruleset (tar.gz / .rules) или список индикаторов (конвертер)
model Source {
  id         String   @id @default(cuid())
  name       String   @unique
  category   String   // ruleset | ip-list | domain-list | url-list
  kind       String   // url | tarball | local | upload  (tarball = архив с .rules внутри)
  url        String?
  format     String   @default("auto") // snort2 | snort3 | suricata | auto
  authType   String   @default("none") // none | oinkcode | authkey | basic
  extraJson  String?  // настройки конвертера/авторизации (proto, ports, msgPrefix, sidRange, header)
  enabled    Boolean  @default(true)
  priority   Int      @default(100) // чем ниже, тем выше приоритет при конфликте SID
  status     String   @default("never") // ok | error | never
  lastFetchAt DateTime?
  lastError  String?
  ruleCount  Int      @default(0)
  sizeBytes  Int      @default(0)
  badge      String?  // recommended | duplicate | legacy | paid | converter
  notes      String?  // анализ источника
  builtin    Boolean  @default(false)
  ownerId    String?  // Enterprise: пользователь-владелец («свои источники»); null — общий/каталог
  deletedAt  DateTime? // не null — источник в корзине (не участвует в загрузке/сборке)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  rules      Rule[]

  @@index([ownerId])
}

// Правило конкретного источника
model Rule {
  id          Int    @id @default(autoincrement())
  sourceId    String
  source      Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sid         Int
  rev         Int    @default(0)
  action      String
  proto       String
  msg         String?
  clsType     String?
  raw         String
  contentHash String
  suricataOk  Boolean @default(true) // совместимость с Suricata
  compatNotes String?
  createdAt   DateTime @default(now())
  @@unique([sourceId, sid])
  @@index([sid])
  @@index([sourceId])
}

// Результат сборки итогового набора
model Build {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  totalRules Int
  statsJson  String   // статистика: по источникам, дубликатам, конфликтам, конвертации
  policyJson String   // применённые политики дедупликации
  fileName   String
  filePath   String
  sha256     String
  sizeBytes  Int
  source     String   @default("manual") // manual | cron
}

// Настройки (k-v)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Категория итогового набора: группировка правил по classtype.
// Строки создаются автоматически при анализе правил (scan), пользователь
// управляет: включение/выключение в сборке, переименование, скрытие.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique  // значение classtype; "none" — правила без classtype
  label     String?           // пользовательское отображаемое имя
  enabled   Boolean  @default(true) // false — правила категории не попадают в сборку
  hidden    Boolean  @default(false) // true — скрыта пользователем из раздела «Категории»
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Пользовательское решение по отдельному правилу (переживает перезагрузку источников):
// enabled=false — правило исключено из сборки, несмотря на источник и категорию
model RuleOverride {
  sid       Int      @id
  enabled   Boolean  @default(true)
  note      String?
  updatedAt DateTime @updatedAt
}

// Журнал событий
model LogEntry {
  id        Int      @id @default(autoincrement())
  ts        DateTime @default(now())
  level     String   // info | warn | error | success
  scope     String   // fetch | build | export | vpn | scheduler | system
  message   String
  detailJson String?
  @@index([ts])
}

// WireGuard профиль
model VpnProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  config    String   // wg-quick формат
  active    Boolean  @default(false)
  lastCheckAt DateTime?
  lastStatusJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Многопользовательский режим (только редакция Enterprise) ─────────────────
// Community-редакция этих таблиц не использует: аутентификации нет, весь
// функционал доступен как раньше. Первая регистрация в Enterprise получает
// роль admin (bootstrap), остальные — pending до верификации администратором.

// Пользователь системы
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  passwordHash String    // scrypt$N$r$p$salt$hash — см. src/lib/security/password.ts
  role         String    @default("user")  // admin | user
  status       String    @default("pending") // pending | active | disabled
  verifiedAt   DateTime?
  verifiedBy   String?   // id администратора, код Telegram/TOTP или 'bootstrap'
  failedLogins Int       @default(0)  // счётчик неудач подряд (анти-брутфорс)
  lockedUntil  DateTime? // до этого времени вход заблокирован (анти-брутфорс)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  tokens       DownloadToken[]

  // ── Двухфакторная аутентификация (2FA) ────────────────────────────────────
  twoFactor             String    @default("none") // none | telegram | totp
  telegramUsername      String?   // @username для кодов верификации (без @, lowercase)
  telegramChatId        String?   // chat_id привязан, когда пользователь отправил боту /start
  totpSecret            String?   // секрет TOTP (base32, RFC 4648)
  verificationCode      String?   // текущий одноразовый код (открытый — нужен для отправки в Telegram)
  verificationExpiresAt DateTime? // срок действия кода (5 минут)
  verificationAttempts  Int       @default(0) // число неверных вводов кода (макс 5)

  @@index([telegramUsername])
}

// Сессия веб-интерфейса (cookie ndrh_sid). В БД хранится только SHA-256 токена.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  @@index([userId])
}

// Персональный токен скачивания правил (GET /api/export, ?token= / Authorization).
// В БД — только SHA-256; полный токен показывается пользователю один раз.
model DownloadToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  tokenHash     String    @unique
  prefix        String    // первые 12 символов для отображения в кабинете
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  lastIp        String?
  downloadCount Int       @default(0)
  bytesServed   Int       @default(0)
  @@index([userId])
}

// Журнал событий безопасности: регистрации, входы/отказы, верификации,
// срабатывания лимитов и очередей. Доступен администратору (вкладка «Пользователи»).
model AuthEvent {
  id     Int      @id @default(autoincrement())
  ts     DateTime @default(now())
  kind   String   // register | login_ok | login_fail | login_lock | login_pending | login_disabled | logout | verify | disable | enable | role_change | delete_user | token_create | token_revoke | download | download_denied | ratelimit | queue_full
  email  String?
  userId String?
  ip     String?
  detail String?
  @@index([ts])
  @@index([kind])
}
