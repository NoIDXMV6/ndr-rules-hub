# scripts/: каталог песочницы игнорируется, НО скрипты, поставляемые в образе
# хаба и документации, обязаны версионироваться (в v1.11.0 repair-скрипт из-за
# этого не попал в коммит и был утерян)
/scripts/*
!/scripts/clearndr-update.sh
!/scripts/clearndr-repair-stack.sh
!/scripts/clearndr-events-restore.sh
!/scripts/clearndr-osd3-workspaces-fix.sh
!/scripts/clearndr-osd-analytics-setup.sh
!/scripts/clearndr-osd-dashboard-import.sh
!/scripts/osd-pack-generator.py
!/scripts/osd-packs
!/scripts/test-clearndr-osd-mock.sh
!/scripts/test-clearndr-update-mock.sh
!/scripts/test-clearndr-repair-mock.sh
!/scripts/test-osd-probe-smoke.sh
!/scripts/test-osd-stale-run.ts
!/scripts/gh_release_backfill.sh
/mini-services
dev.log
server.log
*.db

